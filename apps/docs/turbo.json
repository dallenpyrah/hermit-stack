{
  "extends": ["//"],
  "tags": ["app"],
  "tasks": {
    "generate": {
      "inputs": ["content/**", "source.config.ts", "src/fences/**", "package.json"],
      "outputs": [".source/**", ".fences/**"]
    },
    "typecheck": {
      "dependsOn": ["transit", "generate"],
      "inputs": [
        "content/**",
        "src/**",
        "tests/**",
        "next.config.ts",
        "source.config.ts",
        "package.json",
        "tsconfig.json",
        "tsconfig.fences.json",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tools/rules/tsconfig.base.json"
      ]
    },
    "lint": {
      "dependsOn": ["transit", "generate", "@repo/rules#build"],
      "inputs": [
        "content/**",
        "src/**",
        "tests/**",
        "next.config.ts",
        "source.config.ts",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tools/rules/tsconfig.base.json",
        "$TURBO_ROOT$/oxlint.config.ts"
      ]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": [
        "content/**",
        "src/**",
        "next.config.ts",
        "source.config.ts",
        "assets/**",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputs": ["out/**"],
      "env": ["NEXT_TELEMETRY_DISABLED"]
    }
  }
}
