{
  "name": "@repo/cli",
  "version": "0.0.0",
  "private": true,
  "description": "The ledger Api as a command line: every subcommand and flag is derived from LedgerApi with toCli, and each call reaches a server through the typed client over HTTP.",
  "bin": {
    "ledger": "./src/ledger.main.ts"
  },
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#tests/*": "./tests/*.ts"
  },
  "scripts": {
    "typecheck": "effect-tsgo tsrs --noEmit -p tsconfig.json",
    "lint": "effect-tsgo --tsrs-lint oxlint -c ../../oxlint.config.ts --type-aware --tsconfig tsconfig.json src tests",
    "test": "vitest run"
  },
  "dependencies": {
    "@alchemy.run/domain": "catalog:",
    "@effect/platform-node": "catalog:",
    "@repo/ledger": "workspace:*",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
