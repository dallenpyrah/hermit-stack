{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/platform-node",
          "@effect/vitest",
          "effect/cli",
          "effect/http",
          "effect/rpc",
          "effect/Stdio"
        ],
        "diagnosticSeverity": {
          // The command tree toCli derives is an Effect CLI command, an unstable Effect module, so exporting it exposes
          // That type by design.
          "apiStabilityLeak": "off"
        }
      }
    ]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
