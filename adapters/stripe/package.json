{
  "name": "@repo/stripe",
  "version": "0.0.0",
  "private": true,
  "description": "Stripe as the billing context's payment processor: implements the Payments port and turns Stripe webhooks into billing commands. The only package that imports Stripe.",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*",
    "#tests/*": "./tests/*.ts"
  },
  "exports": {
    "./payments": "./src/stripe-payments.layer.ts",
    "./stripe-events": "./src/stripe-event.schema.ts",
    "./webhook": "./src/stripe-webhook.adapter.ts"
  },
  "scripts": {
    "typecheck": "effect-tsgo tsrs --noEmit -p tsconfig.json",
    "lint": "effect-tsgo --tsrs-lint oxlint -c ../../oxlint.config.ts --type-aware --tsconfig tsconfig.json src tests",
    "test": "vitest run"
  },
  "dependencies": {
    "@alchemy.run/domain": "catalog:",
    "@distilled.cloud/stripe": "catalog:",
    "@repo/billing": "workspace:*",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
