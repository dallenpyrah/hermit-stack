{
  "name": "@repo/archil",
  "version": "0.0.0",
  "private": true,
  "description": "Archil behind @repo/storage's Disks and Sandboxes ports, and the Archil resources an infra stack declares. The only package that imports Archil.",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*",
    "#tests/*": "./tests/*.ts"
  },
  "exports": {
    "./infra": "./src/archil.resource.ts",
    "./storage": "./src/archil-storage.layer.ts"
  },
  "scripts": {
    "typecheck": "effect-tsgo tsrs --noEmit -p tsconfig.json",
    "lint": "effect-tsgo --tsrs-lint oxlint -c ../../oxlint.config.ts --type-aware --tsconfig tsconfig.json src tests",
    "test": "vitest run"
  },
  "dependencies": {
    "@alchemy.run/archil": "catalog:",
    "@distilled.cloud/archil": "catalog:",
    "@repo/storage": "workspace:*",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
