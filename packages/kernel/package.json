{
  "name": "@repo/kernel",
  "version": "0.0.0",
  "private": true,
  "description": "What every context shares: ids, brands, shared errors and span names. It imports nothing but effect.",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*",
    "#tests/*": "./tests/*.ts"
  },
  "exports": {
    "./span-name": "./src/telemetry/span-name.pure.ts"
  },
  "scripts": {
    "typecheck": "effect-tsgo tsrs --noEmit -p tsconfig.json",
    "lint": "effect-tsgo --tsrs-lint oxlint -c ../../oxlint.config.ts --type-aware --tsconfig tsconfig.json src tests",
    "test": "vitest run",
    "mutants": "VITEST_MAX_WORKERS=1 mutant-cafe --advisory && mutants --all",
    "mutants:diff": "VITEST_MAX_WORKERS=1 mutant-cafe --in-diff-range main...HEAD --advisory && mutants"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
