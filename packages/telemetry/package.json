{
  "name": "@repo/telemetry",
  "version": "0.0.0",
  "private": true,
  "description": "The telemetry service every host requires and the glue an OTLP adapter provides it through, with a recording fake and an OTLP collector for tests.",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*",
    "#tests/*": "./tests/*.ts"
  },
  "exports": {
    "./exporter": "./src/telemetry-exporter.layer.ts",
    "./otlp-collector": "./tests/telemetry-exporter.fake.ts",
    "./recording": "./tests/telemetry.fake.ts",
    "./telemetry": "./src/telemetry.service.ts"
  },
  "scripts": {
    "typecheck": "effect-tsgo tsrs --noEmit -p tsconfig.json",
    "lint": "effect-tsgo --tsrs-lint oxlint -c ../../oxlint.config.ts --type-aware --tsconfig tsconfig.json src tests",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
