{
  "name": "@repo/schedule",
  "version": "0.0.0",
  "private": true,
  "description": "Recurring work as a Domain aggregate that re-arms itself: each tick does the work and schedules the next one.",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*",
    "#tests/*": "./tests/*.ts"
  },
  "exports": {
    "./arm": "./src/recurring/arm/arm.command.ts",
    "./pause": "./src/recurring/pause/pause.command.ts",
    "./rearm": "./src/recurring/tick/rearm.policy.ts",
    "./recurring": "./src/recurring/recurring.aggregate.ts",
    "./recurring-name": "./src/recurring/recurring.id.ts",
    "./ticked": "./src/recurring/tick/ticked.event.ts"
  },
  "scripts": {
    "typecheck": "effect-tsgo tsrs --noEmit -p tsconfig.json",
    "lint": "effect-tsgo --tsrs-lint oxlint -c ../../oxlint.config.ts --type-aware --tsconfig tsconfig.json src tests",
    "test": "vitest run",
    "mutants": "VITEST_MAX_WORKERS=1 mutant-cafe --advisory && mutants --all",
    "mutants:diff": "VITEST_MAX_WORKERS=1 mutant-cafe --in-diff-range main...HEAD --advisory && mutants"
  },
  "dependencies": {
    "@alchemy.run/domain": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
