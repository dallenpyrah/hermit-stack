{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The panel half runs in the host's iframe and reaches the window it posts to.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedExperimentalApis": ["effect/ai/McpClient", "effect/ai/McpClientError"],
        "allowedUnstableApis": [
          "@effect/platform-node",
          "@effect/vitest",
          "effect/FileSystem",
          "effect/Path",
          "effect/ai",
          "effect/http",
          "effect/rpc"
        ],
        "diagnosticSeverity": {
          // The surfaces Domain derives (Effect RPC, HttpApi, MCP) are unstable Effect modules, so exporting them exposes those types by design.
          "apiStabilityLeak": "off"
        }
      }
    ]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
