# The environment variables rules' scripts read. Consumers import this file from their own .env.schema.
# Each script runs under `varlock run --filter "#<tag>"`, which checks only the items with that tag, fails before the script starts when a required one is missing, and redacts every @sensitive value from piped output.
# @defaultRequired=false @defaultSensitive=false
# ---

# Minutes checkout-lock waits for a landing, or for the checks reading a checkout, before it gives up. Defaults to 30.
# @tag(checkout-lock)
CHECKOUT_LOCK_MINUTES=

# Label checkout-lock names a holder by, the same one heavy names its slot holders by. Defaults to the holder's working directory.
# @tag(checkout-lock)
HEAVY_LABEL=
