# Every environment variable hermit-stack's code reads. `pnpm lint:env` (rules-env) fails on a read this file, or a file it imports, does not declare.
# The format is varlock's, but nothing here runs varlock: code reads each variable through Effect `Config` under the name declared here, with `Config.redacted` for a @sensitive one.
# @defaultRequired=false @defaultSensitive=false
# @import(./tools/rules/.env.schema)
# ---
# Which platform a services/api server process runs the ledger's actors on. `local` keeps them in memory in that process.
APP_TARGET=local
# The address the services/api server listens on. Set 0.0.0.0 in a container.
HOST=127.0.0.1
# The port the services/api server listens on, read by Alchemy's Node server.
PORT=3000

# Telemetry for any OTLP/HTTP backend (@repo/otlp), in the standard OpenTelemetry names.
# Base URL the exporters post /v1/traces, /v1/logs and /v1/metrics below.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Headers sent with every export, as key=value pairs separated by commas, values URL-encoded. They usually carry a token.
# @sensitive
OTEL_EXPORTER_OTLP_HEADERS=
# The service.name every span, log and metric is exported under, read by @repo/otlp and @repo/axiom.
OTEL_SERVICE_NAME=

# Telemetry for Axiom (@repo/axiom).
# Origin of the edge deployment that stores the datasets, such as https://us-east-1.aws.edge.axiom.co.
AXIOM_URL=
# An ingest token that may write to the datasets below.
# @sensitive
AXIOM_TOKEN=
# The dataset, of kind otel:traces:v1, that traces go to.
AXIOM_DATASET=
# The dataset, of kind otel:logs:v1, that logs go to. Logs are not exported when it is unset.
AXIOM_LOGS_DATASET=

# The base URL of the server apps/cli calls, such as http://localhost:3000. Its --server flag wins over it.
LEDGER_URL=

# The key better-auth signs session cookies with, at least 32 characters. Rotating it signs every user out.
# @sensitive
AUTH_SECRET=
# The origin better-auth's routes are served from, such as https://app.example.com. better-auth infers it from each request when unset.
AUTH_BASE_URL=

# Email through Resend (@repo/resend).
# Resend's API origin. Defaults to https://api.resend.com; a test points it at a local stand-in.
RESEND_BASE_URL=
# An API key that may send email.
# @sensitive
RESEND_API_KEY=
# The sender every email comes from, as address or "Name <address>", on a domain verified in Resend.
RESEND_FROM=
# How long a send may take before it is treated as lost and retried later, such as "10 seconds", the default.
RESEND_TIMEOUT=

# Push notifications through Firebase Cloud Messaging (@repo/fcm), authorised as a service account.
# FCM's API origin. Defaults to https://fcm.googleapis.com.
FCM_BASE_URL=
# Google's OAuth token endpoint. Defaults to https://oauth2.googleapis.com/token.
FCM_TOKEN_URL=
# The Firebase project the messages are sent from.
FCM_PROJECT_ID=
# The service account's email, client_email in its JSON key file.
FCM_CLIENT_EMAIL=
# The service account's PEM private key, private_key in its JSON key file; written \n line breaks are accepted.
# @sensitive
FCM_PRIVATE_KEY=
# How long a send may take before it is treated as lost and retried later, such as "10 seconds", the default.
FCM_TIMEOUT=

# Push notifications through Apple Push Notification service (@repo/apns), with a token-based connection.
# APNs's origin. Defaults to https://api.push.apple.com; https://api.sandbox.push.apple.com is the development one.
APNS_BASE_URL=
# The 10-character Key ID of the .p8 signing key.
APNS_KEY_ID=
# The 10-character Team ID the key belongs to.
APNS_TEAM_ID=
# The .p8 key's PEM text; written \n line breaks are accepted.
# @sensitive
APNS_PRIVATE_KEY=
# The app's bundle ID, sent as apns-topic.
APNS_TOPIC=
# How long a send may take before it is treated as lost and retried later, such as "10 seconds", the default.
APNS_TIMEOUT=

# Webhooks over HTTP (@repo/webhook-http).
# How long a receiver may take to answer before the attempt fails, such as "15 seconds", the default.
WEBHOOK_HTTP_TIMEOUT=
